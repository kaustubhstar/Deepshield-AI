ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated browser origins. Add your deployed frontend HTTPS origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DEVICE=cpu
INFERENCE_MAX_CONCURRENCY=1
CHECKPOINT_FILENAME=deepshield_efficientnet_b0.pt
METADATA_FILENAME=model_metadata.json

MAX_IMAGE_BYTES=8388608
MAX_VIDEO_BYTES=83886080
MAX_VIDEO_SECONDS=120
VIDEO_MAX_FRAMES=24
AUTHENTIC_THRESHOLD=0.35
MANIPULATED_THRESHOLD=0.65
RATE_LIMIT_PER_MINUTE=30/minute
